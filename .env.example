# Your bot's token from the Discord Developer Portal (Bot tab -> Reset Token)
DISCORD_BOT_TOKEN=paste_your_bot_token_here

# The exact name of the Discord role allowed to use leadership commands
# (case-sensitive)
LEADERSHIP_ROLE_NAME=Leadership

# The channel ID where daily picks and 30-minute reminders get posted.
# Enable Developer Mode in Discord (User Settings -> Advanced), then
# right-click the channel -> Copy Channel ID.
LEADERSHIP_CHANNEL_ID=paste_your_channel_id_here

# Hours to add to UTC to get YOUR game's server time (e.g. -2 for UTC-2,
# 8 for UTC+8). This varies by game and sometimes by server -- see
# SETUP_GUIDE.md for how to figure out your own value.
GAME_SERVER_UTC_OFFSET=0

# Optional: a link to wherever your alliance keeps its time-zone conversion
# chart (a channel, pinned message, spreadsheet, etc.). If set, it's included
# in the /ping-for-times DM so people don't have to go hunting for it. Leave
# blank to omit it from that message entirely.
TIME_CONVERSION_CHART_URL=

# Optional: skip the automatic daily pick (and reminder) on certain days of
# the week, in SERVER time. This only sets the STARTING value the first time
# the bot ever runs -- after that, leadership can turn it on/off live in
# Discord with /toggle-weekend-pause, no server access needed. Off by default.
# Leadership can still manually /assign-conductor or /assign-vip on a paused
# day if they want to run one.
PAUSE_ON_WEEKENDS=false

# Which days count as "weekend". Comma separated, full weekday names,
# case-insensitive. This one is NOT live-toggleable -- changing it requires
# editing .env and restarting the bot.
WEEKEND_DAYS=Saturday,Sunday
